{
  "name": "@_linked/livekit",
  "version": "0.1.0",
  "description": "Self-hosted LiveKit adapter for @_linked/live-sessions",
  "linkedPackage": true,
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/livekit.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package": {
      "types": "./dist/package.d.ts",
      "import": "./dist/package.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:e2e": "npm run build && node test/integration.mjs"
  },
  "dependencies": {
    "@_linked/live-sessions": "^0.1.0",
    "@_linked/core": "^2.22.2",
    "@livekit/protocol": "1.51.0",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "esbuild": "0.28.2",
    "playwright": "1.61.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
